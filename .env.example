# Core research/account configuration
INITIAL_CAPITAL=10000
MAX_POSITION_FRACTION=0.20
MAX_DAILY_LOSS_FRACTION=0.02
MAX_DRAWDOWN_FRACTION=0.10
FEE_BPS=10
SLIPPAGE_BPS=5
STOP_LOSS_FRACTION=0.03
TAKE_PROFIT_FRACTION=0.06
MAX_HOLDING_BARS=0
COOLDOWN_BARS=0
DATA_SOURCE=binance
SYMBOL=BTC/USDT
TIMEFRAME=30m

# Runtime execution mode: paper | sandbox | live
EXECUTION_MODE=paper
ENVIRONMENT=development

# Application API authentication. Required in production.
API_KEY=

# Exchange credentials. Required for sandbox/live mode.
# Never commit real credentials to Git.
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_SECRET=
EXCHANGE_PASSWORD=

# Live execution requires ALL of the following to be deliberately enabled.
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_TOKEN=
MAX_LIVE_ORDER_NOTIONAL=250
MAX_LIVE_ORDERS_PER_DAY=10
LIVE_RECONCILE_INTERVAL_SECONDS=60
KILL_SWITCH=false

# Scheduler / persistence
SCHEDULER_INTERVAL_SECONDS=300
DATABASE_URL=sqlite:///./data/agent.db

# Grok AI Strategy Lab. Keep the key server-side and never expose it to the web client.
AI_ENABLED=false
XAI_API_KEY=
XAI_MODEL=grok-4.6
AI_TIMEOUT_SECONDS=60
AI_MAX_TURNS=5
