# THE TRADER v4.0
INITIAL_CAPITAL=10000
MAX_POSITION_FRACTION=0.20
MAX_DAILY_LOSS_FRACTION=0.02
MAX_DRAWDOWN_FRACTION=0.10
FEE_BPS=1.0
SLIPPAGE_BPS=2.0
STOP_LOSS_FRACTION=0.03
TAKE_PROFIT_FRACTION=0.06
MAX_HOLDING_BARS=0
COOLDOWN_BARS=1

DATA_SOURCE=yfinance
SYMBOL=SPY
TIMEFRAME=1h
UNIVERSE=SPY,QQQ

# v4.0 is paper-only
EXECUTION_MODE=paper
ENVIRONMENT=development
PAPER_BROKER=simulator
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

SCHEDULER_INTERVAL_SECONDS=3600
DATABASE_URL=sqlite:///./data/agent.db
API_KEY=

# Optional local AI research layer. Never grants execution authority.
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

AI_TIMEOUT_SECONDS=60
AI_MAX_TURNS=5

# Human-in-the-loop notification gates
NOTIFICATION_MIN_OOS_ACCURACY=0.58
NOTIFICATION_MIN_EXPECTANCY=0
NOTIFICATION_MIN_SAMPLE=50
NOTIFICATION_DAILY_LIMIT=3
NOTIFICATION_COOLDOWN_MINUTES=60
